root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# ktlint（по Spotless позвонить）Прочтите следующую конфигурацию
[*.{kt,kts}]
ktlint_code_style = ktlint_official
max_line_length = 140
# Эта библиотека идиоматическая「KDoc Резюме + аннотации к абзацам（Описание раздела）」стиль，Это правило конфликтует с ним и не может быть автоматически исправлено.
ktlint_standard_no-consecutive-comments = disabled
# Сохраняйте импорт явным，Не свернуто при импорте с подстановочными знаками
ij_kotlin_name_count_to_use_star_import = 2147483647
ij_kotlin_name_count_to_use_star_import_with_prefix = 2147483647
