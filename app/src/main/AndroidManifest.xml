<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Полная ссылка на беспроводную связь CarPlay: Bluetooth RFCOMM (канал управления iAP2) + Wi-Fi (присоединение к точке доступа/mDNS) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation" />
    <!-- WifiNetworkSpecifier (сеть для конкретного приложения) по-прежнему требует разрешения на определение местоположения на Android 12/12L (API 31–32);
         13+ заменено на NEARBY_WIFI_DEVICES, эти два разрешения больше не будут применяться во время выполнения.
         Уровень объявления должен быть в паре FINE+COARSE (обязательно для lint CoarseFineLocation). -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- «Поиск неспаренных устройств» при выборе целевого автомобиля: Android 12+ требует отдельной авторизации;
         NeverForLocation означает, что результаты сканирования не используются для позиционирования (разрешение на позиционирование отменяется) -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <!-- Аудиоканал: требуется AudioPlaybackCapture (захват встроенных звуков мультимедиа/навигации) -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Отключение громкости мультимедиа мобильного телефона при активации аудиоканала (звук раздается только из автомобиля) и восстановление после отключения. -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- Требуется для темного экрана (замена экрана ожидания); в системный список «Показывать поверх других приложений» входят только приложения, задекларировавшие это разрешение. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <uses-feature android:name="android.hardware.bluetooth" android:required="false" />
    <uses-feature android:name="android.hardware.wifi" android:required="false" />

    <queries>
        <package android:name="moe.shizuku.privileged.api" />
        <package android:name="com.autonavi.amapauto" />
        <package android:name="com.autonavi.minimap" />
        <!-- На рабочем столе приложения необходимо перечислить все запускаемые приложения (видимость пакета Android 11+). -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".SenderApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.CarPlaySender">

        <!-- Мобильная консоль сама управляет вращением: это интерфейс инструмента с отслеживанием состояния (положение прокрутки, сворачивание карты,
             Заполнен SSID точки доступа, отображается всплывающее окно), при перестройке системы они все будут потеряны.
             После объявления configChanges Activity не перестраивается, а состояние просмотра сохраняется как есть;
             Всплывающие окна, зависящие от размера экрана, пересчитываются в onConfigurationChanged. -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Настройки автомобиля и машины (со стороны мобильного телефона): Вторичная страница меню + хост фрагмента контента (общая панель с двумя столбцами автомобиля и машины).
             Не объявляйте configChanges: эти две страницы являются кратковременными страницами инструментов, которые вращаются и перестраиваются без потери состояния;
             Домашняя страница — это постоянная консоль, на которой должен сохраняться прокручиваемый/сворачиваемый/заполненный контент. -->
        <activity
            android:name=".PhoneSettingsActivity"
            android:exported="false" />
        <activity
            android:name=".SettingsContentActivity"
            android:exported="false" />

        <service
            android:name=".service.CarPlayService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice|mediaProjection" />

        <!-- Плацдарм для бесшумной проекции экрана (получите токен MediaProjection для записи звука при автоматическом подключении):
             Exported=true позволяет поднять `am start` Шизуку (только для оболочки).
             START_ACTIVITIES_FROM_BACKGROUND, нет START_ANY_ACTIVITY);
             noHistory + ignoreFromRecents + TaskAffinity="" гарантирует, что следов не останется. -->
        <activity
            android:name=".audio.SilentProjectionActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.CarPlaySender.SilentTranslucent" />

        <!-- Автоматически подключаться к шине: ACL_CONNECTED/ACL_DISCONNECTED в списке неявных широковещательных исключений,
             Статическая регистрация манифеста может активировать процесс приложения после его завершения (docs/AUTO-CONNECT.md).
             Exported=true — потому что системный стек Bluetooth отправляет данные с независимым uid; Фильтрация целевых автомобилей осуществляется в приемнике. -->
        <receiver
            android:name=".bt.CarBluetoothReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.bluetooth.device.action.ACL_CONNECTED" />
                <action android:name="android.bluetooth.device.action.ACL_DISCONNECTED" />
            </intent-filter>
        </receiver>

        <!-- Виртуальный экран рабочего стола (экспортирован: при необходимости можно запустить Shell am start) -->
        <activity
            android:name=".launcher.DockActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.CarPlaySender.Launcher" />

        <activity
            android:name=".launcher.GridActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.CarPlaySender.Launcher" />

        <!-- Мониторинг уведомлений (перечисление медиа-сессий): для музыкальной карты требуются «права на использование уведомлений»;
             Шизуку можно авторизовать в автоматическом режиме с помощью уведомления cmdallow_listener, если оно присутствует. -->
        <service
            android:name=".media.MediaListenerService"
            android:exported="false"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Настройки автомобиля и машины (двойной столбец): введите значок «Настройки автомобиля и машины» на рабочем столе, только для использования в приложении. -->
        <activity
            android:name=".launcher.SettingsActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.CarPlaySender.Settings" />

        <!-- Сидзуку (режим невидимого экрана: указанный дисплей при запуске + прямое примечание MotionEvent) -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:multiprocess="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />
    </application>
</manifest>
