<?xml version="1.0" encoding="utf-8"?>
<!-- Горизонтальная строка экрана приложения страницы настройки: значок + имя (красный текст статуса может быть включен ниже) + флажок переключения статуса (можно щелкнуть всю строку) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="4dp"
    android:layout_marginRight="4dp"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_app_row"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingLeft="8dp"
    android:paddingTop="7dp"
    android:paddingRight="8dp"
    android:paddingBottom="7dp">

    <ImageView
        android:id="@+id/oriIcon"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/oriName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#FFF5F5F7"
            android:textSize="13sp" />

        <!-- Мелкий текст состояния наложения на стороне системы: скрыт по умолчанию; отображается при включении, подсвечивается красным, если находится слева (флажок снят, но система включена) -->
        <TextView
            android:id="@+id/oriHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#FFFF6B6B"
            android:textSize="10.5sp"
            android:visibility="gone" />
    </LinearLayout>

    <ImageView
        android:id="@+id/oriCheck"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:importantForAccessibility="no" />
</LinearLayout>
