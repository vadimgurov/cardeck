<?xml version="1.0" encoding="utf-8"?>
<!-- Одностраничная сетка значков (количество столбцов фиксировано - 4; количество строк задается кодом в соответствии с горизонтальным и вертикальным экранами - горизонтальный экран, характеристики CarPlay 3 строки,
     Вертикальный экран адаптируется до 6 рядов, чтобы избежать фиксации 3 рядов и растягивания сетки в тонкую и высокую полосу; размер сетки рассчитывается по коду согласно экрану) -->
<GridLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:columnCount="4"
    android:alignmentMode="alignMargins"
    android:useDefaultMargins="false"
    android:paddingLeft="10dp"
    android:paddingRight="10dp"
    android:paddingTop="8dp"
    android:paddingBottom="30dp" />
