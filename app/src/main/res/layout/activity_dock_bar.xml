<?xml version="1.0" encoding="utf-8"?>
<!-- Нижняя док-станция CarPlay (используется, когда автомобиль находится в портретном режиме): ⌂ | Горизонтальный запуск приложений | Время/батарея.
     dp для размера: значение = прототип дизайна пикселей ÷ 2,625 (основа проекта 1160×540 при 420 точек на дюйм; плотность стыковки
     Выдается пропорционально короткой стороне холста — см. комментарий Activity_dock_sidebar).
     Размер шрифта не жестко запрограммирован в XML: DockActivity нажимает «Design px × designScale», чтобы установить его в PX.
     Обои: DockActivity подключает «полнопоточный фрагмент холста» к DockWallpaper (тот же источник и путь, что и у рабочего стола);
     Окно непрозрачно (полупрозрачное окно будет видно сквозь синтезированные системой обои телефона — см. комментарий Activity_dock_sidebar). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000">

    <ImageView
        android:id="@+id/dockWallpaper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY" />

    <View
        android:id="@+id/dockScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="2.29dp"
        android:paddingRight="3.81dp"
        android:paddingTop="1.52dp"
        android:paddingBottom="1.52dp">

        <ImageView
            android:id="@+id/dockHome"
            android:layout_width="38.10dp"
            android:layout_height="match_parent"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="На главный экран"
            android:padding="9.90dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_dock_home" />

        <View
            android:layout_width="0.38dp"
            android:layout_height="match_parent"
            android:layout_marginLeft="2.29dp"
            android:layout_marginTop="2.29dp"
            android:layout_marginBottom="2.29dp"
            android:background="#3A3A3C" />

        <HorizontalScrollView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginLeft="2.29dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/dockApps"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical" />
        </HorizontalScrollView>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingLeft="3.81dp">

            <TextView
                android:id="@+id/dockClock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:letterSpacing="0.03"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/dockBatteryText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1.14dp"
                android:textColor="#B0B0B8" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
