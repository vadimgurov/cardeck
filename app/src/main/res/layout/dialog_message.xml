<?xml version="1.0" encoding="utf-8"?>
<!-- Универсальное всплывающее окно темного сообщения (заголовок + прокручиваемый текст + основное действие справа).
     Тот же набор визуальных эффектов, что и «Отказ от ответственности» и «Выбор целевого автомобиля»: bg_dialog_panel + жетон M3 + кнопка-капсула.
     Светлая тема по умолчанию системы AlertDialog отделена от темного пользовательского интерфейса этого приложения (реальная машина была представлена ​​18 октября 2026 г.).
     Если требуется окно подсказки, используйте DarkMessageDialog вместо простого AlertDialog. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_panel"
    android:orientation="vertical"
    android:paddingStart="18dp"
    android:paddingTop="18dp"
    android:paddingEnd="18dp"
    android:paddingBottom="14dp">

    <TextView
        android:id="@+id/msgTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/m3_on_surface"
        android:textSize="17sp"
        android:textStyle="bold" />

    <!-- Текст: сверхдлинная прокрутка (максимум 46% высоты экрана, верхний предел задается кодом), нижняя кнопка всегда видна. -->
    <ScrollView
        android:id="@+id/msgScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:scrollbars="vertical">

        <TextView
            android:id="@+id/msgBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="4dp"
            android:textColor="@color/m3_on_var"
            android:textSize="12.5sp" />
    </ScrollView>

    <LinearLayout
        android:id="@+id/msgActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="end"
        android:orientation="horizontal" />
</LinearLayout>
