<?xml version="1.0" encoding="utf-8"?>
<!-- Правая панель в режиме приборной панели (разделенный экран): Карта управления музыкой.
     Форма карты: окружающие поля + закругленные углы (обрезка контура настройки кода) + фон = обои этой области.
     Размытие фрагмента + темный экран (сила соответствует доке, DockPrefs). Обои/темный экран заполняются кодом.
     «⤢ Полноэкранная карта» зафиксирована внизу карточки. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/dashWallpaper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY" />

    <View
        android:id="@+id/dashScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingLeft="14dp"
        android:paddingRight="14dp">

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="0.75" />

        <!-- Обложка альбома (отображается, когда есть обложка, а закругленные углы обрезаны по коду) -->
        <ImageView
            android:id="@+id/dashCover"
            android:layout_width="118dp"
            android:layout_height="118dp"
            android:layout_marginBottom="14dp"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop"
            android:visibility="gone" />

        <!-- В статическом подзаголовке не может быть написано «Сейчас исполняется»: он не меняется в зависимости от статуса и будет несовместим с копией статуса ниже.
             («Не воспроизводится»/«Невозможно прочитать информацию о воспроизведении») является прямым противоречием (фактическое тестирование скриншота 2026-10-19).
             Нейтральная метка «Медиа», конкретный статус выражается двухстрочным заголовком/подзаголовком. -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.1"
            android:text="Музыка"
            android:textColor="#FFE0E0E5"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/dashMediaTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:text="Ничего не воспроизводится"
            android:textColor="#FFF5F5F7"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/dashMediaArtist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:text="Нет данных о воспроизведении"
            android:textColor="#FFE0E0E5"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/dashPrev"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:importantForAccessibility="no"
                android:padding="8dp"
                android:src="@drawable/ic_media_prev" />

            <ImageView
                android:id="@+id/dashPlayPause"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_marginLeft="16dp"
                android:layout_marginRight="16dp"
                android:importantForAccessibility="no"
                android:padding="8dp"
                android:src="@drawable/ic_media_play" />

            <ImageView
                android:id="@+id/dashNext"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:importantForAccessibility="no"
                android:padding="8dp"
                android:src="@drawable/ic_media_next" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/dashMediaProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="14dp"
            android:max="1000"
            android:progressDrawable="@drawable/bg_media_progress"
            android:visibility="gone" />

        <TextView
            android:id="@+id/dashMediaTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFeatureSettings="tnum"
            android:text="0:00 / 0:00"
            android:textColor="#FFE0E0E5"
            android:textSize="11.5sp" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />
    </LinearLayout>
</FrameLayout>
