<?xml version="1.0" encoding="utf-8"?>
<!-- Всплывающее окно с отказом от ответственности: исправлен заголовок → прокручиваемый текст → исправлена нижняя кнопка.
     Визуализация соответствует всплывающему окну «Выбрать целевой автомобиль» (bg_dialog_panel/темный жетон M3/кнопка капсулы). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_panel"
    android:orientation="vertical"
    android:paddingStart="18dp"
    android:paddingTop="18dp"
    android:paddingEnd="18dp"
    android:paddingBottom="14dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Предупреждение и условия"
        android:textColor="@color/m3_on_surface"
        android:textSize="17sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/disclaimerSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Пожалуйста, прочтите его полностью, прежде чем использовать его в первый раз. После принятия вы можете просмотреть его в любое время в нижней части основного интерфейса."
        android:textColor="@color/m3_on_var"
        android:textSize="11.5sp" />

    <!-- Текст: Высота ограничена (около 60% высоты экрана), необходимо прокрутить, чтобы закончить. -->
    <ScrollView
        android:id="@+id/disclaimerScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_weight="1"
        android:fadeScrollbars="false"
        android:scrollbars="vertical">

        <LinearLayout
            android:id="@+id/disclaimerSections"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingEnd="4dp" />
    </ScrollView>

    <!-- Причина отказа от принятия (обратный отсчет/еще не достигнута нижняя граница); скрыть, когда это приемлемо -->
    <TextView
        android:id="@+id/disclaimerBlockHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:textColor="@color/m3_amber"
        android:textSize="11.5sp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <!-- Отклонение: не подлежит обратному отсчету/прокачке (отклонение не должно блокироваться) -->
        <TextView
            android:id="@+id/btnDecline"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/bg_tbtn"
            android:gravity="center"
            android:text="Отказаться"
            android:textColor="@color/m3_on_var"
            android:textSize="13.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnAccept"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="10dp"
            android:layout_weight="1.4"
            android:background="@drawable/bg_cta_fill"
            android:enabled="false"
            android:gravity="center"
            android:textColor="@color/disclaimer_accept_text"
            android:textSize="13.5sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
