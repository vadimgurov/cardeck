<?xml version="1.0" encoding="utf-8"?>
<!-- Боковая панель CarPlay (вертикальная полоса слева): время + заряд батареи вверху, запущенные приложения посередине и возврат на рабочий стол внизу.
     dp для размера: значение = прототип дизайна пикселей ÷ 2,625 (основа дизайна 1160×540 при 420 точек на дюйм ——
     док-станция 48dp=126 пикселей, часы 22 пикселя, см. design/launcher-proto.html). закрепить виртуальный экран
     Плотность распределяется SessionController пропорционально короткой стороне холста (VirtualLauncher.DOCK_WIDTH_DP
     Примечание): Автомобильный дисплей с высоким разрешением увеличивается пропорционально плотности, и эта пропорция соответствует эталонному стандарту Audi.
     Размер шрифта не жестко запрограммирован в XML: DockActivity нажимает «Design px × designScale», чтобы установить PX.
     (Нет необходимости использовать sp — док-станция представляет собой холст дизайна на уровне пикселей и не масштабируется вместе со шрифтом телефона).
     Обои: DockActivity подключает «полнопоточную нарезку холста» к DockWallpaper в коде (с рабочим столом).
     Начало, тот же путь, непрерывное соединение); холст 20% черного цвета, чтобы покрыть обои и обеспечить читаемость содержимого.
     Окно должно быть непрозрачным — в полупрозрачном окне система синтезирует собственные обои телефона в этот виртуальный экран.
     (Основная причина, по которой когда-то на док-станции отображались обои мобильного телефона, не совпадали с обоями рабочего стола). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000">

    <ImageView
        android:id="@+id/dockWallpaper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY" />

    <View
        android:id="@+id/dockScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingLeft="3.05dp"
        android:paddingRight="3.05dp"
        android:paddingTop="4.57dp"
        android:paddingBottom="4.57dp">

    <TextView
        android:id="@+id/dockClock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:maxLines="1"
        android:letterSpacing="0.03"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:includeFontPadding="false" />

    <TextView
        android:id="@+id/dockBatteryText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2.29dp"
        android:gravity="center"
        android:maxLines="1"
        android:textColor="#B0B0B8"
        android:includeFontPadding="false" />

    <FrameLayout
        android:id="@+id/dockBatteryBar"
        android:layout_width="17.52dp"
        android:layout_height="1.52dp"
        android:layout_marginTop="1.90dp"
        android:background="#3A3A3C">

        <View
            android:id="@+id/dockBatteryFill"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:background="#34C759" />
    </FrameLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/dockApps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal" />
    </ScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="0.38dp"
        android:layout_marginBottom="1.52dp"
        android:background="#3A3A3C" />

    <ImageView
        android:id="@+id/dockHome"
        android:layout_width="match_parent"
        android:layout_height="41.90dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="На главный экран"
        android:padding="9.90dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_dock_home" />
    </LinearLayout>
</FrameLayout>
