<?xml version="1.0" encoding="utf-8"?>
<!-- Настройки автомобиля (две колонки: левое меню 210dp/правое содержимое) – сравните с design/launcher-proto.html.
     Преобразование размера: после применения передискретизации экрана ×1,5 плотность составляет ≈301dpi, а количество пикселей потока — ≈ dp×1,25, поэтому прототип px ÷ 1,25 = dp.
     Нажмите меню, чтобы переключить содержимое в правом столбце (Управление настольными приложениями/Применить суперсэмплинг). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="#FF000000">

    <!-- ===================== Левая колонка: Меню ==================== -->
    <LinearLayout
        android:id="@+id/settingsMenu"
        android:layout_width="210dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:paddingTop="10dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?android:attr/selectableItemBackground"
            android:drawableLeft="@drawable/ic_chevron_left"
            android:drawablePadding="4dp"
            android:gravity="center_vertical"
            android:paddingLeft="4dp"
            android:paddingTop="6dp"
            android:paddingRight="10dp"
            android:paddingBottom="6dp"
            android:text="Главный экран"
            android:textColor="#FF0A84FF"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:layout_marginTop="12dp"
            android:layout_marginRight="8dp"
            android:letterSpacing="0.14"
            android:text="Настройки автомобиля"
            android:textColor="#FF636366"
            android:textSize="11sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/menuDesktopApps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:background="@drawable/bg_menu_item"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="9dp">

            <ImageView
                android:layout_width="23dp"
                android:layout_height="23dp"
                android:background="@drawable/bg_menu_chip"
                android:importantForAccessibility="no"
                android:padding="5dp"
                android:src="@drawable/ic_menu_grid" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="9dp"
                android:text="Приложения на главном экране"
                android:textColor="#FFF5F5F7"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/menuSupersample"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="?android:attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="9dp">

            <ImageView
                android:layout_width="23dp"
                android:layout_height="23dp"
                android:background="@drawable/bg_menu_chip"
                android:importantForAccessibility="no"
                android:padding="5dp"
                android:src="@drawable/ic_menu_zoom" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="9dp"
                android:text="Повышенное разрешение приложений"
                android:textColor="#FF8E8E93"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/menuOrientation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="?android:attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="9dp">

            <ImageView
                android:layout_width="23dp"
                android:layout_height="23dp"
                android:background="@drawable/bg_menu_chip"
                android:importantForAccessibility="no"
                android:padding="5dp"
                android:src="@drawable/ic_screen_rotation" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="9dp"
                android:text="Альбомная ориентация приложений"
                android:textColor="#FF8E8E93"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/menuDock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="?android:attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="9dp">

            <ImageView
                android:layout_width="23dp"
                android:layout_height="23dp"
                android:background="@drawable/bg_menu_chip"
                android:importantForAccessibility="no"
                android:padding="5dp"
                android:src="@drawable/ic_menu_dock" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="9dp"
                android:text="Настройки панели Dock"
                android:textColor="#FF8E8E93"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/menuDefaultMap"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="?android:attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="9dp">

            <ImageView
                android:layout_width="23dp"
                android:layout_height="23dp"
                android:background="@drawable/bg_menu_chip"
                android:importantForAccessibility="no"
                android:padding="5dp"
                android:src="@drawable/ic_menu_map" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="9dp"
                android:text="Карты по умолчанию"
                android:textColor="#FF8E8E93"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/menuDisplay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="?android:attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="9dp">

            <ImageView
                android:layout_width="23dp"
                android:layout_height="23dp"
                android:background="@drawable/bg_menu_chip"
                android:importantForAccessibility="no"
                android:padding="5dp"
                android:src="@drawable/ic_menu_display" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="9dp"
                android:text="Экран"
                android:textColor="#FF8E8E93"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="1px"
        android:layout_height="match_parent"
        android:background="#FF1E1E21" />

    <!-- ==================== Правый столбец: содержимое (нажмите меню для переключения) ==================== -->
    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1">

        <!-- Правый столбец: контейнер фрагмента контента (двойной столбец для автомобиля и телефона/общая панель для вторичного меню мобильного телефона) -->
        <FrameLayout
            android:id="@+id/settingsContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1" />

        <!-- Легкая подсказка (всплывающее сообщение на странице; появление и исчезновение контролируется кодом) -->
        <TextView
            android:id="@+id/settingsToast"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="21dp"
            android:alpha="0"
            android:background="@drawable/bg_settings_toast"
            android:paddingLeft="13dp"
            android:paddingTop="7dp"
            android:paddingRight="13dp"
            android:paddingBottom="7dp"
            android:textColor="#FFE5E5EA"
            android:textSize="12sp" />
    </FrameLayout>
</LinearLayout>
