<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingLeft="20dp"
    android:paddingRight="13dp"
    android:paddingTop="14dp"
    android:paddingBottom="10dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="11dp"
        android:text="После включения приложение с вертикальным экраном будет отображаться на экране автомобиля в полноэкранном режиме. Сам переключатель сохраняется и автоматически вступит в силу при следующем подключении; переопределение системы вступает в силу только во время сеанса и будет автоматически восстановлено в конце сеанса, и приложение вернется в нормальное направление без ручной обработки. Примечание. Некоторый текст интерфейса может стать больше или меньше. При переключении переключателя система немедленно перезапустит целевое приложение, чтобы оно вступило в силу (работающее приложение потеряет несохраненное состояние интерфейса)."
        android:textColor="#FF8E8E93"
        android:textSize="12sp" />

    <!-- Баннер о недоступности возможностей: отображается, когда собственное ПЗУ не регистрирует эти два ChangeId (элементы настройки OEM).
         В то же время весь столбец становится серым. В противном случае пользователь будет нажимать переключатель несколько раз и получит только сообщение об ошибке (фактический тест на Redmi Android 13). -->
    <TextView
        android:id="@+id/oriUnsupportedBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:background="#33E8C072"
        android:paddingLeft="10dp"
        android:paddingTop="8dp"
        android:paddingRight="10dp"
        android:paddingBottom="8dp"
        android:textColor="#FFE8C072"
        android:textSize="11.5sp"
        android:visibility="gone" />

    <!-- Остается за пределами панели: Оверлей открыт на стороне системы, но приложение удалено (при удалении предпочтение пропадает) - его нельзя нажать в списке.
         Уборку можно подвести только вверху. По умолчанию скрыт, появляется при наличии таких остатков -->
    <TextView
        android:id="@+id/oriOrphanBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:background="#33FF6B6B"
        android:paddingLeft="10dp"
        android:paddingTop="8dp"
        android:paddingRight="10dp"
        android:paddingBottom="8dp"
        android:textColor="#FFFF6B6B"
        android:textSize="11.5sp"
        android:visibility="gone" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <TextView
            android:id="@+id/listLoading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:text="Загрузка списка приложений…"
            android:textColor="#7C8B8B"
            android:textSize="12.5sp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/oriList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingRight="26dp"
            android:scrollbars="vertical" />

        <LinearLayout
            android:id="@+id/oriListIndex"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="right|center_vertical"
            android:orientation="vertical"
            android:paddingLeft="6dp" />
    </FrameLayout>
</LinearLayout>
