<?xml version="1.0" encoding="utf-8"?>
<!-- 车机/手机共用的「显示」面板。外层 ScrollView：车机侧内容区只有约 200dp 高，
     4 段内容（真息屏 / 分辨率 / 帧率 / 触摸节流）必须能滚动，否则最后一段被裁掉。 -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="20dp"
        android:paddingTop="14dp"
        android:paddingRight="13dp"
        android:paddingBottom="10dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="11dp"
            android:text="Видеопоток генерирует виртуальные экраны и закодированные изображения на основе процентного разрешения автомобиля (логическая компоновка остается неизменной). Изменение разрешения вступит в силу при следующем подключении; частота кадров будет увеличена до частоты обновления, и переключатель вступит в силу в реальном времени."
            android:textColor="#FF8E8E93"
            android:textSize="12sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Выключать экран телефона при подключении"
            android:textColor="#FFF5F5F7"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_segment"
            android:orientation="horizontal"
            android:padding="3dp">

            <TextView
                android:id="@+id/btnScreenOffOn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_segment_sel"
                android:paddingLeft="18dp"
                android:paddingTop="6dp"
                android:paddingRight="18dp"
                android:paddingBottom="6dp"
                android:text="Вкл."
                android:textColor="#FFFFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnScreenOffOff"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="2dp"
                android:paddingLeft="18dp"
                android:paddingTop="6dp"
                android:paddingRight="18dp"
                android:paddingBottom="6dp"
                android:text="Выкл."
                android:textColor="#FF8E8E93"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/screenOffNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="После успешного подключения физически выключите панель телефона (система остается в активном состоянии, а виртуальный экран отображается как обычно); если он выключен, будет использоваться только темный экран. Дважды нажмите кнопку питания, чтобы восстановить экран."
            android:textColor="#FF8E8E93"
            android:textSize="12sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Автоподключение в автомобиле"
            android:textColor="#FFF5F5F7"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_segment"
            android:orientation="horizontal"
            android:padding="3dp">

            <TextView
                android:id="@+id/btnAutoConnectOn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_segment_sel"
                android:paddingLeft="18dp"
                android:paddingTop="6dp"
                android:paddingRight="18dp"
                android:paddingBottom="6dp"
                android:text="Вкл."
                android:textColor="#FFFFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnAutoConnectOff"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="2dp"
                android:paddingLeft="18dp"
                android:paddingTop="6dp"
                android:paddingRight="18dp"
                android:paddingBottom="6dp"
                android:text="Выкл."
                android:textColor="#FF8E8E93"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/autoConnectNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Сеанс начнется автоматически при подключении Bluetooth автомобиля (должен быть активирован Shizuku). Для запуска в фоновом режиме требуется разрешение «Показывать поверх других приложений»; если это разрешение отсутствует, оно будет предоставлено автоматически."
            android:textColor="#FF8E8E93"
            android:textSize="12sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Исходный журнал HID"
            android:textColor="#FFF5F5F7"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_segment"
            android:orientation="horizontal"
            android:padding="3dp">

            <TextView
                android:id="@+id/btnHidRawOn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_segment_sel"
                android:paddingLeft="18dp"
                android:paddingTop="6dp"
                android:paddingRight="18dp"
                android:paddingBottom="6dp"
                android:text="Вкл."
                android:textColor="#FFFFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnHidRawOff"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="2dp"
                android:paddingLeft="18dp"
                android:paddingTop="6dp"
                android:paddingRight="18dp"
                android:paddingBottom="6dp"
                android:text="Выкл."
                android:textColor="#FF8E8E93"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/hidRawNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Для калибровки клавиш: после открытия напишите строку HID-RAW (uuid + шестнадцатеричные байты) для каждого кадра сообщения HID и настройте сопоставление клавиш в соответствии с байтами, напечатанными при нажатии рулевого колеса/ручки. Пожалуйста, отключайте его в обычное время, чтобы избежать очистки журнала."
            android:textColor="#FF8E8E93"
            android:textSize="12sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Разрешение видеопотока"
            android:textColor="#FFF5F5F7"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <SeekBar
                android:id="@+id/displayScaleSeek"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="26" />

            <TextView
                android:id="@+id/displayScaleValue"
                android:layout_width="52dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:gravity="right"
                android:textColor="#FF8E8E93"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/displayScaleNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="После сохранения вступит в силу следующее подключение."
            android:textColor="#FF8E8E93"
            android:textSize="12sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Целевая частота кадров"
            android:textColor="#FFF5F5F7"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_segment"
            android:orientation="horizontal"
            android:padding="3dp">

            <TextView
                android:id="@+id/btnFps30"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_segment_sel"
                android:paddingLeft="18dp"
                android:paddingTop="6dp"
                android:paddingRight="18dp"
                android:paddingBottom="6dp"
                android:text="30 fps"
                android:textColor="#FFFFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnFps60"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="2dp"
                android:paddingLeft="18dp"
                android:paddingTop="6dp"
                android:paddingRight="18dp"
                android:paddingBottom="6dp"
                android:text="60 fps"
                android:textColor="#FF8E8E93"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Переключение вступает в силу в реальном времени во время соединения; карта героя отображает «фактическую/целевую» частоту кадров в реальном времени"
            android:textColor="#FF8E8E93"
            android:textSize="12sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Задержка передачи касаний"
            android:textColor="#FFF5F5F7"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <SeekBar
                android:id="@+id/throttleSeek"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="6" />

            <TextView
                android:id="@+id/throttleValue"
                android:layout_width="72dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:gravity="right"
                android:textColor="#FF8E8E93"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Когда взаимодействие запаздывает, но частота кадров нормальная (накапливается отправка событий), увеличьте тест; перетаскивание вступает в силу немедленно"
            android:textColor="#FF8E8E93"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
