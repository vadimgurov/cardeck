<?xml version="1.0" encoding="utf-8"?>
<!-- Поле выделения фокуса (ручка iDrive/навигация по клавишам на рулевом колесе): рисуйте штрих 3dp только после достижения фокуса.
     Используется в качестве переднего плана представления — не закрывает исходный фон (цвет фона карты значков задается кодом). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <stroke
                android:width="3dp"
                android:color="#FF4FC3F7" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
        </shape>
    </item>
</selector>
