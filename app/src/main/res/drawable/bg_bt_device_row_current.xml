<?xml version="1.0" encoding="utf-8"?>
<!-- Низ ряда, где находится текущая цель: светло-зеленый низ + пульсация нажатия (отличается от чисто темного низа обычного ряда,
     Благодаря сплошной зеленой капсуле «✓ Current» справа вы можете сразу найти ее при сканировании) -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#1FFFFFFF">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1F58C08A" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</ripple>
