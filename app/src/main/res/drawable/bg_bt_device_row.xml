<?xml version="1.0" encoding="utf-8"?>
<!-- Строка устройства во всплывающем окне: такие же темные закругленные углы, как и строка приложения на странице настроек + пульсация нажатия -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#1FFFFFFF">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FF151B1C" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</ripple>
