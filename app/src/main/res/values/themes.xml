<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Унифицируйте темный цвет системной панели: если панель навигации не задана явно, MagicOS будет использовать **белый** фон в соответствии со светлой темой.
         (Фактическое измерение #FCFCFC) — В обычном интерфейсе внизу имеется белая рамка, но когда экран находится в режиме ожидания (полноэкранная черная маска)
         Это особенно неудобно и похоже, что оно не адаптировано к полноэкранному режиму (отзыв пользователя о скриншоте 2026-10-18).
         Поддельная маска экрана представляет собой окно APPLICATION_OVERLAY и может закрывать только область содержимого (системная панель представлена SystemUI
         нарисован на нем), поэтому цвет системной панели сам должен быть черным, чтобы гармонировать с маской. -->
    <style name="Theme.CarPlaySender" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:statusBarColor">#000000</item>
        <item name="android:navigationBarColor">#000000</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:colorBackground">#101418</item>
    </style>

    <!-- Рабочий стол автомобиля (док/сетка/настройки): прозрачность окна - обои рисуются на нижнем слое компоновщиком GL,
         В активности не используется цвет фона (иначе обои будут закрыты) -->
    <style name="Theme.CarPlaySender.Launcher" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:colorBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:statusBarColor">#000000</item>
        <item name="android:navigationBarColor">#000000</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <!-- Настройки автомобиля и машины: скользящий переход для входа/выхода (доступны все версии windowAnimationStyle,
         Не зависит от устаревшего API 34 overridePendingTransition) -->
    <style name="Theme.CarPlaySender.Settings" parent="Theme.CarPlaySender.Launcher">
        <item name="android:windowAnimationStyle">@style/CarPlaySettingsAnimation</item>
    </style>

    <style name="CarPlaySettingsAnimation" parent="">
        <item name="android:activityOpenEnterAnimation">@anim/settings_in</item>
        <item name="android:activityOpenExitAnimation">@anim/stay</item>
        <item name="android:activityCloseEnterAnimation">@anim/stay</item>
        <item name="android:activityCloseExitAnimation">@anim/settings_out</item>
    </style>

    <!-- Плагин бесшумной проекции экрана (audio/SilentProjectionActivity): полностью прозрачный, без анимации и без фокуса.
         Это действие наследует android.app.Activity (а не AppCompat), поэтому родительская тема может использовать только темы платформы. -->
    <style name="Theme.CarPlaySender.SilentTranslucent" parent="android:Theme.Translucent.NoTitleBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:colorBackgroundCacheHint">@null</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowDisablePreview">true</item>
        <item name="android:statusBarColor">#000000</item>
        <item name="android:navigationBarColor">#000000</item>
    </style>
</resources>
