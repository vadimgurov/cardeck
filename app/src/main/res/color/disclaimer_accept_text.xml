<?xml version="1.0" encoding="utf-8"?>
<!-- Цвет текста кнопки «Принять»: используйте светлый цвет, когда он отключен (обратный отсчет/не скольжение вниз).
     Поскольку при отключении фон имеет очень светлый небесно-голубой цвет (#247EDCE6), исходный темный текст практически невидим.
     Секунды обратного отсчета должны быть читаемыми, иначе пользователь не узнает, почему кнопка не нажимается. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:color="#9AB0BEBE"
        android:state_enabled="false" />
    <item android:color="@color/m3_on_primary" />
</selector>
