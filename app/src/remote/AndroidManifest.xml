<?xml version="1.0" encoding="utf-8"?>
<!-- Наложение удаленного варианта: эксклюзивные разрешения и компоненты моста удаленной отладки. Объединено только в удаленном варианте, в пакете daily/release нет этого файла. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Замкнутый цикл переустановки: PackageInstaller инициирует установку (система все равно будет запрашивать подтверждение). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:name=".bridge.BridgeApp"
        android:usesCleartextTraffic="true"
        tools:replace="android:name,android:usesCleartextTraffic">
        <!-- UseCleartextTraffic: Мост отладки может быть чистым HTTP (например, frp+VPS).
             http://IP:8787），API 28+ по умолчанию отключает открытый текст, что приводит к сбою загрузки APK.
             (21 октября 2026 г. фактическое измерение HTTP-трафика в открытом виде не разрешено).
             Выпускаются только отладочные пакеты; пакеты релизов не затрагиваются. -->

        <!-- Единственный вход на рабочий стол для отладочной версии — «Удаленная отладка CarDeck»: введите адрес/код сопряжения, и на странице появится «Открыть основной интерфейс».
             SingleTop: onNewIntent будет использоваться при повторном вводе запроса подтверждения/продолжения установки с параметрами, и экземпляр не будет наложен. -->
        <activity
            android:name=".bridge.BridgeSetupActivity"
            android:exported="true"
            android:label="CarDeck удаленная отладка"
            android:launchMode="singleTop"
            android:theme="@style/Theme.CarPlaySender">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Удалите значок рабочего стола основного интерфейса модератора отладки (сохраните само действие: страница настроек/команда моста все равно должны его открыть),
             В противном случае в отладочной версии на рабочем столе будет два входа и три CarDecks, и пользователи не смогут их отличить. -->
        <activity
            android:name="io.github.shaonialife.cardeck.MainActivity"
            android:exported="true"
            tools:node="merge">
            <intent-filter tools:node="remove">
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Переработка состояния PackageInstaller: **необходимо объявить фильтр намерений** — — настраиваемое действие
             Без фильтра трансляция никогда не будет доставлена на этот ресивер, подтверждение установки (PENDING_USER_ACTION)
             Никто не тянет его вверх, и замкнутый контур отключается на первом контуре (фактический тест от 21 октября 2026 г. «Нет эффекта при нажатии»);
             Exported=false + setPackage ограничил отправку только этого пакета/владельцев PendingIntent -->
        <receiver
            android:name=".bridge.InstallReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="io.github.shaonialife.cardeck.BRIDGE_INSTALL_RESULT" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
