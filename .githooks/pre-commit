#!/бин/ш
# Перехват перед отправкой: белый список адресов электронной почты автора + автоматическое форматирование + Android Lint.
# Включить через `git config core.hooksPath .githooks` согласно соглашению хранилища (выполнить один раз после клонирования).
set -eu
cd "$(git rev-parse --show-toplevel)"

# 0) Контроль электронной почты автора: этот репозиторий является общедоступным, и **не разрешено** записывать корпоративные/частные адреса электронной почты в историю отправки.
#    (После отправки коммита его невозможно отозвать, и GitHub постоянно индексирует адрес электронной почты автора).
#    Разрешенный список написан здесь и будет изменен одновременно с добавлением юридических лиц.
ALLOWED_EMAIL_DOMAIN="users.noreply.github.com"
AUTHOR_EMAIL=$(git config user.email || echo "")
case "$AUTHOR_EMAIL" in
*"@$ALLOWED_EMAIL_DOMAIN") ;;
*)
    echo ""
    echo "✗ Отправка заблокирована：текущий user.email = '${AUTHOR_EMAIL}'"
    echo "  Этот склад позволяет только *@${ALLOWED_EMAIL_DOMAIN} формировать почтовый ящик（публичный репозиторий，Избегайте утечки электронной почты компании）。"
    echo "  Ремонт：git config user.email '16135960+shaonialife@users.noreply.github.com'"
    echo "  （Этот склад .git/config должен был быть установлен；если покрыто，Проверьте, используется ли --global или переменные среды）"
    echo ""
    exit 1
    ;;
esac

STAGED=$(git diff --cached --name-only --diff-filter=ACMR)
[ -z "$STAGED" ] && exit 0

# 1) Формат: только если сценарий Kotlin/Gradle подготовлен.
if printf '%s\n' "$STAGED" | grep -qE '\.(kt|kts)$'; then
    echo "▶ Проверьте перед отправкой：Форматирование кода（spotlessApply）..."
    ./gradlew --console=plain -q spotlessApply

    # Добавляйте повторно только те файлы, которые были «уже временно сохранены и изменены путем форматирования» во временное хранилище.
    for f in $STAGED; do
        case "$f" in
        *.kt | *.kts)
            if ! git diff --quiet -- "$f" 2>/dev/null; then
                git add -- "$f"
                echo "  Автоматически форматируется и переустанавливается: $f"
            fi
            ;;
        esac
    done
fi

# 2) Lint: только тогда, когда исходный код/ресурсы/скрипты сборки временно сохранены (проблема со стандартом исключена в lint-baseline.xml)
if printf '%s\n' "$STAGED" | grep -qE '^(app/src/|[^ ]*\.gradle\.kts$|gradle\.properties$)'; then
    echo "▶ Проверьте перед отправкой：Android Lint（lintStandardDebug）..."
    if ./gradlew --console=plain -q :app:lintStandardDebug; then
        echo "✓ lint Пройти"
    else
        echo ""
        echo "✗ lint Проверка не удалась，Эта заявка заблокирована。"
        echo "  отчет: app/build/reports/lint-results-debug.html"
        echo "  Устраните проблему и повторите попытку；Если это подтверждается как ложная тревога，Доступно на app/build.gradle.kts из lint блокировать"
        echo "  нажать issue id закрыть，Или обновите базовый уровень после проверки.（./gradlew :app:updateLintBaseline）。"
        exit 1
    fi
fi

exit 0
