#!/бин/ш
# Проверьте перед отправкой: отсканируйте адреса электронной почты всех авторов и отправителей материалов, которые будут отправлены.
# Отказываться от отправки до тех пор, пока существует почтовый ящик, на который нет ответа (публичный склад, после отправки отправки ее невозможно действительно отозвать).
#
# Зачем нам нужен этот слой в дополнение к хуку фиксации:
#  - `git commit --no-verify` может обходить предварительную фиксацию;
#  - Cherry-pick/rebase/merge **продолжит использовать автора** исходного представления, которого нельзя увидеть с помощью предварительной фиксации;
#  - Материалы, полученные с других складов, имеют собственные адреса электронной почты.
# Этот уровень проверяет «объекты, которые собираются покинуть локальную машину» и может охватывать все вышеперечисленные ситуации.
set -eu
cd "$(git rev-parse --show-toplevel)"

ALLOWED_DOMAIN="users.noreply.github.com"
ZERO="0000000000000000000000000000000000000000"

fail=0
# стандартный ввод на строку: <локальная ссылка> <локальный sha> <удаленная ссылка> <удаленный sha>
while read -r local_ref local_sha remote_ref remote_sha || [ -n "${local_ref:-}" ]; do
    [ -z "${local_sha:-}" ] && continue
    [ "${local_sha}" = "${ZERO}" ] && continue # удалить ветку，Нет отправки

    if [ "$remote_sha" = "$ZERO" ]; then
        # На пульте еще нет этой ветки: проверьте всю историю
        range="$local_sha"
        label="Вся история"
    else
        # Удаленный конец уже существует: проверьте только новую деталь
        range="$remote_sha..$local_sha"
        label="Приращение"
    fi

    # Необходимо проверить электронную почту автора и отправителя (оба отображаются на GitHub).
    bad=$(
        git log --format='%ae%n%ce' $range 2>/dev/null |
            grep -v "@${ALLOWED_DOMAIN}$" |
            grep -v '^$' |
            sort -u || true
    )

    if [ -n "$bad" ]; then
        echo ""
        echo "✗ Push заблокирован：${local_ref} → ${remote_ref}（${label}）Содержит адреса электронной почты, не включенные в белый список.："
        printf '%s\n' "$bad" | sed 's/^/    /'
        echo ""
        echo "  Этот склад позволяет только *@${ALLOWED_DOMAIN}（публичный репозиторий，Избегайте утечки электронной почты компании）。"
        echo "  Варианты ремонта："
        echo "    · Еще не отправлено：git config user.email '16135960+shaonialife@users.noreply.github.com'"
        echo "    · Отправлено, но не отправлено：Опубликовано после переписывания автором."
        echo "    · История с других складов：git filter-branch/filter-repo Перепишите, а затем нажмите"
        echo ""
        fail=1
    fi
done

exit $fail
